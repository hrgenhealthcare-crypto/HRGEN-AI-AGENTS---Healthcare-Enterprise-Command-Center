# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server-only temporary CRM API gate (minimum 32 random bytes).
# Keep in backend secrets, never expose to browser, public demos or VITE_* variables.
# Without it, /api/leads GET/POST/PATCH fail closed (503).
HRGEN_INTERNAL_API_TOKEN=""

# STAGING ONLY. Browser-safe Supabase project URL and publishable/anon key.
# Never use service_role or JWT secret in VITE_* fields.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-side origin for Supabase Auth JWKS JWT verification (asymmetric signing).
# Staff app_metadata must be provisioned by a trusted server/admin action:
# tenant_id = UUID; hrgen_role = owner|admin|sales|viewer.
# Never rely on editable user_metadata for role or tenant.
SUPABASE_URL=""

# PRIVATE STAGING SERVER ONLY — Supabase project secret key (sb_secret_...).
# Never set VITE_SUPABASE_SECRET_KEY; never commit the actual value or send
# it to any browser, public log, demo, GitHub Action, or user-session client.
# Required alongside SUPABASE_URL for the server's staff_memberships lookup.
# Before configuring, apply/review SQL migration 20261108000002 in a private
# approved Supabase staging project and provision synthetic staff grants.
# Missing/invalid secret => /api/staff fails closed (503).
SUPABASE_SECRET_KEY=""
